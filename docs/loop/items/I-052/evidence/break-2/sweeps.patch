+            for z in g.wall.min[2]..g.wall.max[2] { for x in g.wall.min[0]..g.wall.max[0] {
+                if w.can_break([x, g.wall.min[1] - 1, z]) { dig_under += 1; }
+            }}
+            eprintln!("diggable cells just under the wall: {dig_under}");
+        }
+    }
