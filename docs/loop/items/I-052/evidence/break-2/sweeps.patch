+            for z in z0..z1 {
+                let mut row = format!("z{z:4}:");
+                for x in x0..x1 {
+                    let t = top(&w, x, z);
+                    let pr = !w.can_place([x, t + 1, z]);
+                    row += &format!(" {t:2}{}", if pr { "P" } else { " " });
+                }
+                eprintln!("{row}");
+            }
+            // any non-protected air cell directly above the wall top?
+            let mut open_above = 0;
+            for z in g.wall.min[2]..g.wall.max[2] { for x in g.wall.min[0]..g.wall.max[0] {
+                let p = [x, g.wall.max[1], z];
+                if w.get(p).mat == mat::AIR && w.can_place(p) { open_above += 1; }
+            }}
+            eprintln!("open placeable air cells right above the wall top: {open_above}");
+            // cells just under the wall box that can be dug
