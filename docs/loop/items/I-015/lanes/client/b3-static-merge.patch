+/// The per-state materials of a burnable kind. Only `normal` and `wet`
+/// depend on the kind; the other five states look the same on every kind,
+/// so they are made once and shared through `like` (one material, and so one
+/// bind group, per look instead of one per kind; I-015 step B3).
+fn state_mats(
+    materials: &mut Assets<StandardMaterial>,
+    base: Color,
+    wet: Color,
+    like: Option<&StateMats>,
+) -> StateMats {
+    let wet = materials.add(StandardMaterial {
+        base_color: wet,
+        perceptual_roughness: 0.2,
+        reflectance: 0.6,
+        ..default()
+    });
+    let normal = toon(materials, base);
+    match like {
+        Some(l) => StateMats {
+            normal,
+            wet,
+            ..l.clone()
+        },
+        None => StateMats {
+            normal,
+            hot: glow(materials, Color::srgb(0.75, 0.38, 0.12), 0.35),
+            burning: glow(materials, Color::srgb(0.55, 0.2, 0.05), 1.2),
+            charred: toon(materials, Color::srgb(0.12, 0.1, 0.1)),
+            wet,
+            frosty: glow(materials, Color::srgb(0.8, 0.93, 1.0), 0.25),
+            foamed: toon(materials, Color::srgb(0.9, 0.93, 0.95)),
+        },
     }
 }
 
