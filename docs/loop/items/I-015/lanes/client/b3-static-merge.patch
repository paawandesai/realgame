+    unit: Vec<(AssetId<Mesh>, Mesh)>,
+    /// Baked static scenery: one growing mesh per material.
+    baked: Vec<(Handle<StandardMaterial>, Mesh)>,
+    /// How many scenery pieces went into `baked`.
+    baked_pieces: usize,
+}
+
+/// `src` moved into place by `t`, reduced to positions, normals and UVs with
+/// a u32 index list, so pieces of any unit mesh can be appended to each
+/// other. Normals go through the rotation and the inverse scale (as the
+/// shader does for a scaled entity), so the lighting is unchanged.
+fn bake(src: &Mesh, t: Transform) -> Mesh {
+    let m = src.clone().transformed_by(t);
+    let n = m.count_vertices();
+    let pos = m
+        .attribute(Mesh::ATTRIBUTE_POSITION)
+        .cloned()
+        .expect("unit mesh has positions");
+    let normal = m
+        .attribute(Mesh::ATTRIBUTE_NORMAL)
+        .cloned()
+        .expect("unit mesh has normals");
+    let uv = m
+        .attribute(Mesh::ATTRIBUTE_UV_0)
+        .cloned()
+        .unwrap_or_else(|| vec![[0.0f32, 0.0]; n].into());
+    let idx: Vec<u32> = match m.indices() {
+        Some(i) => i.iter().map(|k| k as u32).collect(),
+        None => (0..n as u32).collect(),
+    };
+    Mesh::new(
+        PrimitiveTopology::TriangleList,
+        RenderAssetUsages::default(),
+    )
+    .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, pos)
+    .with_inserted_attribute(Mesh::ATTRIBUTE_NORMAL, normal)
+    .with_inserted_attribute(Mesh::ATTRIBUTE_UV_0, uv)
+    .with_inserted_indices(Indices::U32(idx))
 }
 
 impl Builder<'_, '_, '_> {
+    /// A static, opaque piece of scenery that never changes: baked into the
+    /// one mesh of its material instead of getting its own entity.
+    fn scenery(&mut self, mesh: &Handle<Mesh>, mat: &Handle<StandardMaterial>, t: Transform) {
+        let src = &self
+            .unit
+            .iter()
+            .find(|(id, _)| *id == mesh.id())
+            .expect("scenery uses a kit mesh")
+            .1;
+        let piece = bake(src, t);
+        match self.baked.iter_mut().find(|(m, _)| m.id() == mat.id()) {
+            Some((_, acc)) => acc.merge(&piece).expect("baked meshes share one layout"),
+            None => self.baked.push((mat.clone(), piece)),
+        }
+        self.baked_pieces += 1;
+    }
+
+    /// Spawns one entity per baked material and logs the count.
+    fn finish_scenery(&mut self, meshes: &mut Assets<Mesh>) {
+        let n = self.baked.len();
+        for (mat, mesh) in std::mem::take(&mut self.baked) {
+            self.commands.spawn((
+                Mesh3d(meshes.add(mesh)),
+                MeshMaterial3d(mat),
+                Transform::IDENTITY,
+            ));
+        }
+        info!("STATIC_MERGE pieces={} meshes={}", self.baked_pieces, n);
+    }
