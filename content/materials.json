{
  "schema": {
    "about": "I-052 block materials (spec section 5.2). One row per material id, in id order (crates/voxel/src/lib.rs mod mat); rows are only appended, because the id is part of the save format. Loaded and checked by crates/voxel/src/materials.rs. \"todo\" marks a value Lane B fills and sources (V10 then fails on any \"todo\"); null means the field does not apply.",
    "id": "material id, 0-255, equal to the row's position",
    "name": "lower-case id used in code and debug commands",
    "phase": "solid | liquid | gas | none, at 20 °C and 1 atm",
    "density_kg_m3": "kg/m³ at 20 °C",
    "melt_c": "melting point, °C at 1 atm (null if it does not melt in play)",
    "boil_c": "boiling point, °C at 1 atm (null if it does not boil in play)",
    "heat_capacity_j_kgk": "specific heat capacity, J/(kg·K)",
    "conductivity_w_mk": "thermal conductivity, W/(m·K)",
    "flammability": "0-1; 0 never burns",
    "ignite_c": "ignition temperature, °C (null if not flammable)",
    "burn_s": "seconds a burning cell burns before it becomes ash or air",
    "hardness_s": "dig time with the Pick, seconds (gameplay); 9999 means it cannot be dug (benches, the hearth, vents and runestone: they are fixtures)",
    "drops": "item name a dig adds to the pack, or null for nothing",
    "atlas": "tile index in the 16 x 16 generated atlas",
    "transparent": "true if faces behind it are drawn (clear pass or cut-out)",
    "solid": "true if it blocks the player and rays in RayMode::Solids",
    "source": "key into content/science-sources.md for the physical values"
  },
